---

<section id="hero" class="bg-cream pt-28 pb-20 md:pt-32 md:pb-28">
  <div class="max-w-6xl mx-auto px-6">
    <div class="flex flex-col md:flex-row items-center gap-12 md:gap-16">
      <div class="flex-1 text-center md:text-left">
        <h1 class="text-4xl md:text-5xl font-extrabold text-deep-slate leading-tight mb-6">
          Ruimte voor mens&nbsp;en&nbsp;werk.
        </h1>
        <p class="text-lg text-charcoal/80 leading-relaxed mb-8 max-w-lg mx-auto md:mx-0">
          Bedrijfsmaatschappelijk werk voor organisaties die aandacht hebben voor het welzijn van hun medewerkers. Persoonlijke begeleiding, met oog voor zowel de mens als de organisatie.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center md:justify-start">
          <a
            href="#contact"
            class="inline-block bg-terracotta text-white font-semibold px-8 py-3 rounded-lg hover:bg-terracotta/90 transition-colors duration-200 text-center"
          >
            Kennismaken
          </a>
          <a
            href="#contact"
            class="inline-block border-2 border-deep-slate text-deep-slate font-semibold px-8 py-3 rounded-lg hover:bg-deep-slate hover:text-white transition-colors duration-200 text-center"
          >
            Neem contact op
          </a>
        </div>
      </div>

      <div class="flex-shrink-0">
        <img
          src={`${import.meta.env.BASE_URL}photos/headshot.jpeg`}
          alt="Alie Visser-Ziel"
          class="w-60 aspect-[3/4] md:w-72 object-cover object-top rounded-2xl shadow-lg"
          loading="eager"
        />
      </div>
    </div>
  </div>
</section>
