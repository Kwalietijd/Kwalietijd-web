---
const year = new Date().getFullYear();
---

<footer class="bg-charcoal py-12">
  <div class="max-w-6xl mx-auto px-6 text-center">
    <img
      src="/logo/kwalietijd_full.svg"
      alt="Balans in kwalietijd — Bedrijfsmaatschappelijk Werk"
      class="w-48 mx-auto mb-6 opacity-90"
    />
    <p class="text-sm text-cream/50">
      &copy; {year} Balans in kwalietijd
    </p>
  </div>
</footer>
